#!/bin/sh
# Blocks commits whose added lines or file names contain a term from a private, local-only denylist.
# The list lives outside this repository on purpose: committing it would itself leak the terms.
# Location: $HADOME_DENYLIST, or ~/.config/hadome-dev/denylist.txt (one term per line, # starts a comment).
list="${HADOME_DENYLIST:-$HOME/.config/hadome-dev/denylist.txt}"
[ -f "$list" ] || exit 0
patterns=$(mktemp)
trap 'rm -f "$patterns"' EXIT
grep -v '^[[:space:]]*#' "$list" | grep -v '^[[:space:]]*$' > "$patterns"
[ -s "$patterns" ] || exit 0
if git diff --cached -U0 --no-color | grep '^+' | grep -v '^+++' | grep -q -i -F -f "$patterns"; then
  echo "pre-commit: staged changes contain a term from the private denylist ($list). Commit blocked." >&2
  exit 1
fi
if git diff --cached --name-only | grep -q -i -F -f "$patterns"; then
  echo "pre-commit: a staged file name contains a term from the private denylist ($list). Commit blocked." >&2
  exit 1
fi
